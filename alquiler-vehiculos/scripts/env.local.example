# Copia este archivo como scripts/.env.local (no se sube a git).
# Formato: una variable por línea. En Bash usa export; en PowerShell run.ps1 acepta KEY=valor sin export.

# Ejemplo (ajusta rutas a tu JDK si quieres fijar Java):
# export JAVA_HOME="C:/Program Files/Java/jdk-22"

# vehiculos-service (lote 2+) — crear la base `vehiculos` en PostgreSQL antes de arrancar:
# export SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vehiculos
# export SPRING_DATASOURCE_USERNAME=postgres
# export SPRING_DATASOURCE_PASSWORD=cambia_esto

# operaciones / Docker: reservado para lotes posteriores
