# =============================================================================
#  env.local.example  →  SOLO PLANTILLA (puede versionarse en Git).
#  run.ps1 NO lee este archivo.
#
#  scripts/.env.local  →  ARCHIVO REAL que sí lee run.ps1 (está en .gitignore).
#  Cómo empezar: copia este archivo y renómbralo a  .env.local  (misma carpeta scripts/).
#  Ahí pones JAVA_HOME y las variables JDBC con prefijo por servicio; las contraseñas solo allí.
# =============================================================================
#
# Formato: una variable por línea, KEY=valor (sin "export") para run.ps1.
# Si ejecutas mvnw a mano en Bash sin run.ps1, puedes export KEY=valor en tu terminal.

# Windows — JAVA_HOME (comillas si hay espacios; run.ps1 las quita al leer):
# JAVA_HOME="C:/Program Files/Java/jdk-22"

# Eureka (vehiculos-service, operaciones-service y api-gateway se registran aquí; mismo default localhost:8761):
# EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://localhost:8761/eureka/

# vehiculos-service — PostgreSQL local (prioridad VEHICULOS_*; SPRING_* solo respaldo en application.yml).
# VEHICULOS_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vehiculos
# VEHICULOS_DATASOURCE_USERNAME=postgres
# VEHICULOS_DATASOURCE_PASSWORD=cambia_esto

# vehiculos-service — Neon (mismo formato JDBC que arriba):
# VEHICULOS_DATASOURCE_URL=jdbc:postgresql://ep-XXXX-pooler.REGION.aws.neon.tech:5432/neondb?sslmode=require
# VEHICULOS_DATASOURCE_USERNAME=neondb_owner
# VEHICULOS_DATASOURCE_PASSWORD=(solo en .env.local)

# ¡Importante!: NO definas SPRING_DATASOURCE_* en el mismo .env si vas a ejecutar también operaciones-service.
# Spring Boot mapea esas vars a spring.datasource global y pisarían la configuración esperada por OPERACIONES_*.

# operaciones-service — otro proyecto/instancia Neon (ej. UNIR-BD-2-OPERACIONES) o PostgreSQL local:
# OPERACIONES_DATASOURCE_URL=jdbc:postgresql://localhost:5432/operaciones
# OPERACIONES_DATASOURCE_USERNAME=postgres
# OPERACIONES_DATASOURCE_PASSWORD=cambia_esto
#
# Si el log muestra "ERROR: Control plane request failed" o Hibernate "Unable to determine Dialect":
# la causa casi siempre es que NO hay conexión JDBC válida (contraseña vacía/errónea, Neon dormido,
# URL mal copiada). No dejes PASSWORD= vacío: o pones la contraseña real o borras la línea para usar
# el default local de application.yml (solo sirve con PostgreSQL local usuario postgres/postgres).

# operaciones-service — URL del catálogo de vehículos (OBSOLETA desde lote 6)
# Ya no se usa: Feign resuelve vehiculos-service por nombre Eureka + LoadBalancer.
# VEHICULOS_CLIENT_URL=http://localhost:8081  # <-- eliminar si existe en tu .env.local

# api-gateway (lote 7): no usa BD; comparte EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE si Eureka no está en localhost.

# Docker / Compose (lote 8):
# Solo aplica si quieres sobrescribir defaults de docker-compose.yml.
# POSTGRES_VEHICULOS_DB=vehiculos
# POSTGRES_VEHICULOS_USER=postgres
# POSTGRES_VEHICULOS_PASSWORD=cambia_esto
# POSTGRES_OPERACIONES_DB=operaciones
# POSTGRES_OPERACIONES_USER=postgres
# POSTGRES_OPERACIONES_PASSWORD=cambia_esto
