{
  "version": 1,
  "description": "Registro de comandos del proyecto. Añade entradas aquí y vuelven a aparecer con run.ps1 -List / ./run.sh list",
  "commands": [
    {
      "id": "eureka-up",
      "title": "Arrancar Eureka Server (desarrollo)",
      "cwd": "..",
      "windows": {
        "program": "mvnw.cmd",
        "args": ["-pl", "eureka-server", "spring-boot:run"]
      },
      "unix": {
        "program": "./mvnw",
        "args": ["-pl", "eureka-server", "spring-boot:run"]
      }
    },
    {
      "id": "compile-all",
      "title": "Compilar todo el multi-módulo (sin tests)",
      "cwd": "..",
      "windows": {
        "program": "mvnw.cmd",
        "args": ["-q", "-DskipTests", "package"]
      },
      "unix": {
        "program": "./mvnw",
        "args": ["-q", "-DskipTests", "package"]
      }
    },
    {
      "id": "vehiculos-up",
      "title": "Arrancar vehiculos-service (desarrollo, requiere PostgreSQL)",
      "cwd": "..",
      "windows": {
        "program": "mvnw.cmd",
        "args": ["-pl", "vehiculos-service", "spring-boot:run"]
      },
      "unix": {
        "program": "./mvnw",
        "args": ["-pl", "vehiculos-service", "spring-boot:run"]
      }
    },
    {
      "id": "operaciones-up",
      "title": "Arrancar operaciones-service (desarrollo, requiere PostgreSQL BD operaciones)",
      "cwd": "..",
      "windows": {
        "program": "mvnw.cmd",
        "args": ["-pl", "operaciones-service", "spring-boot:run"]
      },
      "unix": {
        "program": "./mvnw",
        "args": ["-pl", "operaciones-service", "spring-boot:run"]
      }
    },
    {
      "id": "gateway-up",
      "title": "Arrancar api-gateway (desarrollo, requiere Eureka + MS registrados)",
      "cwd": "..",
      "windows": {
        "program": "mvnw.cmd",
        "args": ["-pl", "api-gateway", "spring-boot:run"]
      },
      "unix": {
        "program": "./mvnw",
        "args": ["-pl", "api-gateway", "spring-boot:run"]
      }
    },
    {
      "id": "compile-gateway",
      "title": "Compilar y test del módulo api-gateway",
      "cwd": "..",
      "windows": {
        "program": "mvnw.cmd",
        "args": ["-pl", "api-gateway", "test"]
      },
      "unix": {
        "program": "./mvnw",
        "args": ["-pl", "api-gateway", "test"]
      }
    },
    {
      "id": "compile-operaciones",
      "title": "Compilar y test del módulo operaciones-service",
      "cwd": "..",
      "windows": {
        "program": "mvnw.cmd",
        "args": ["-pl", "operaciones-service", "test"]
      },
      "unix": {
        "program": "./mvnw",
        "args": ["-pl", "operaciones-service", "test"]
      }
    },
    {
      "id": "compile-vehiculos",
      "title": "Compilar y test del módulo vehiculos-service",
      "cwd": "..",
      "windows": {
        "program": "mvnw.cmd",
        "args": ["-pl", "vehiculos-service", "test"]
      },
      "unix": {
        "program": "./mvnw",
        "args": ["-pl", "vehiculos-service", "test"]
      }
    },
    {
      "id": "compile-eureka",
      "title": "Compilar solo el módulo eureka-server",
      "cwd": "..",
      "windows": {
        "program": "mvnw.cmd",
        "args": ["-pl", "eureka-server", "-q", "-DskipTests", "package"]
      },
      "unix": {
        "program": "./mvnw",
        "args": ["-pl", "eureka-server", "-q", "-DskipTests", "package"]
      }
    },
    {
      "id": "verify-versions",
      "title": "Mostrar versiones de Java y Maven (wrapper)",
      "cwd": "..",
      "windows": {
        "program": "mvnw.cmd",
        "args": ["-v"]
      },
      "unix": {
        "program": "./mvnw",
        "args": ["-v"]
      }
    },
    {
      "id": "compose-up",
      "title": "Levantar stack Docker (build + detached)",
      "cwd": "..",
      "windows": {
        "program": "docker",
        "args": ["compose", "up", "--build", "-d"]
      },
      "unix": {
        "program": "docker",
        "args": ["compose", "up", "--build", "-d"]
      }
    },
    {
      "id": "compose-down",
      "title": "Detener stack Docker y eliminar contenedores",
      "cwd": "..",
      "windows": {
        "program": "docker",
        "args": ["compose", "down"]
      },
      "unix": {
        "program": "docker",
        "args": ["compose", "down"]
      }
    }
  ]
}
